[Unit]
Description=feed scoring (pf_news + pf_social_raw -> pf_feed_score)
After=network-online.target
Wants=network-online.target

[Service]
User=trading
WorkingDirectory=/opt/trading
ExecStart=/opt/trading/engine-venv/bin/python -m runtime.feed.service
Restart=always
RestartSec=60

[Install]
WantedBy=multi-user.target
