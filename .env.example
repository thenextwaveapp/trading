# Runtime / box environment (paper_fleet + fleet_dashboard).
# Copy to .env (gitignored) and fill in. These currently live only on the box;
# this template is what makes a fresh box reproducible from the repo.

# Supabase project the fleet reads/writes (pf_* tables).
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<publishable-anon-key>      # public reads (RLS-scoped)
SUPABASE_SERVICE_KEY=<service-role-key>        # server writes (bypasses RLS) — secret

# HTTP Basic auth wall on the dashboard (fleet_dashboard.py).
FLEET_DASH_USER=<dashboard-username>
FLEET_DASH_PASS=<dashboard-password>

# Anthropic Claude API for plain-English strategy parsing in /parse-strategy.
# Set either ANTHROPIC_API_KEY or CLAUDE_API_KEY.
ANTHROPIC_API_KEY=<claude-api-key>
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Build worker (runtime/engine_worker.py).
BUILD_TRAIN_DAYS=730                           # training window in days
# Optional: directory holding bn_candles_15m.csv.gz / bn_candles_1h.csv.gz.
# Defaults to lab/bn when present; otherwise the worker pages Binance.
PAPERFLEET_CANDLE_CACHE=
