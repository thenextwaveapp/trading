# Web app build-time environment (Vite). Copy to web/.env (gitignored).
# Use the publishable anon key — this ships to the browser; never the service key.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_KEY=<publishable-anon-key>

# Dashboard engine API (live fleet). Vite dev proxies /api + /candles here.
VITE_API_TARGET=http://127.0.0.1:8787
